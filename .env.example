# Copy to .env for local development. These two values are public client
# settings from Supabase → Project Settings → API. They are not service secrets.
# Never commit .env. The Resend API key does not belong here: store it in
# Supabase Vault (see SETUP.md). Do not commit *.secret.sql either.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
